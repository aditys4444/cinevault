<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- CineVault Dark Theme Colors -->
    <color name="colorPrimary">#176BFF</color>
    <color name="colorPrimaryDark">#050A18</color>
    <color name="colorAccent">#35A7FF</color>
    <color name="cinevault_dark">#050A18</color>
    <color name="cinevault_surface">#0E1726</color>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Edge-to-edge dark system bars -->
        <item name="android:statusBarColor">@color/cinevault_dark</item>
        <item name="android:navigationBarColor">@color/cinevault_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Android 12+ SplashScreen API theme -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/cinevault_dark</item>
        <item name="windowSplashScreenBackground">@color/cinevault_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <!-- Dark status/nav bar during splash -->
        <item name="android:statusBarColor">@color/cinevault_dark</item>
        <item name="android:navigationBarColor">@color/cinevault_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>